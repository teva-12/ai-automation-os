# Copy to .env and fill in:  cp .env.example .env
# Generate secrets with:     openssl rand -hex 24   (Windows PowerShell: see README)
# Use hex/alphanumeric secrets only (they are embedded in SQL by the init script).

# ---- PostgreSQL ----
POSTGRES_ADMIN_USER=aios_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
N8N_DB_PASSWORD=CHANGE_ME
AIOS_DB_PASSWORD=CHANGE_ME

# ---- n8n ----
N8N_VERSION=latest
# BACK THIS UP SEPARATELY. Losing it makes every saved credential unrecoverable.
N8N_ENCRYPTION_KEY=CHANGE_ME_32_hex
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public HTTPS URL that Telegram can reach (tunnel). Trailing slash required.
WEBHOOK_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
TZ_LOCAL=Africa/Cairo

# ---- Optional tunnels ----
CLOUDFLARE_TUNNEL_TOKEN=
# Permanent URL with ngrok (see docker-compose.ngrok.yml)
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-name.ngrok-free.dev

# ---- Seed data (used by scripts/seed_owner.sh) ----
OWNER_TELEGRAM_ID=000000000
OWNER_NAME=Your Name

# ---- Backups ----
BACKUP_RETENTION_DAYS=14

# NOTE: Telegram bot token, LLM keys (Gemini / Groq) and the IMAP app password are NOT put here.
# They live in n8n Credentials (encrypted with N8N_ENCRYPTION_KEY).
